{
    "extends": "react-app",
    "rules": {
        "no-unused-vars": "off",
        "no-console": "off",
        "react/prop-types": "off",
        "react-hooks/rules-of-hooks": "off",
        "react-hooks/exhaustive-deps": "off",
        "no-undef": "off",
        "no-redeclare": "off"
    },
    "ignorePatterns": [
        "*.test.js",
        "*.spec.js",
        "build/",
        "node_modules/"
    ]
}